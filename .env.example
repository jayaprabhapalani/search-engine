POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=hn_search

# Outside Docker use localhost; inside compose use postgres/redis as hostnames
DATABASE_URL=postgresql+asyncpg://postgres:changeme@localhost:5432/hn_search
REDIS_URL=redis://localhost:6379

HACKERNEWS_BASE_URL=https://hacker-news.firebaseio.com/v0/

# Comma-separated allowed CORS origins (e.g. http://localhost:5173,https://yourapp.com)
CORS_ORIGINS=http://localhost:5173

# Set to true to log every SQL statement (noisy — keep false in production)
SQL_ECHO=false
